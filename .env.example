# Required for the documented PostgreSQL persistence path.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/recover_ai?schema=public"

# Decision provider. Keep "mock" for deterministic local/demo behavior.
DECISION_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"
OPENROUTER_API_KEY=""
OPENROUTER_MODELS="nvidia/nemotron-3-ultra-550b-a55b:free,minimax/minimax-m3:free,nvidia/nemotron-3.5-lightning:free"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1/chat/completions"
OPENROUTER_SITE_URL=""
OPENROUTER_APP_NAME="RecoverAI"

# Optional Razorpay Test Mode integration. Never use live-mode keys here.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Optional outbound adapters. Missing values select auditable sandbox executors.
RESEND_API_KEY=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
